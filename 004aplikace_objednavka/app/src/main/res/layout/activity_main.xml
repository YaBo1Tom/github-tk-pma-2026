<?xml version="1.0" encoding="utf-8"?>
<!-- Root: scrollable screen so the whole form fits on small displays -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Screen title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/title"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Pizza selection; labels with prices are set in MainActivity -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_pizza"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgPizza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbMargherita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                tools:text="Margherita (139 Kč)" />

            <RadioButton
                android:id="@+id/rbPepperoni"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Pepperoni (159 Kč)" />

            <RadioButton
                android:id="@+id/rbProsciutto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Prosciutto (159 Kč)" />
        </RadioGroup>

        <!-- Extra toppings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_extras"
            android:textSize="18sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbCheese"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Extra sýr (+10 Kč)" />

        <CheckBox
            android:id="@+id/cbOlives"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Extra olivy (+10 Kč)" />

        <CheckBox
            android:id="@+id/cbPeppers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Extra feferonky (+20 Kč)" />

        <CheckBox
            android:id="@+id/cbHam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Extra šunka (+10 Kč)" />

        <!-- Fills the order summary below -->
        <Button
            android:id="@+id/btnOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_order" />

        <!-- Order summary: one line per item with its price, total at the end -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_summary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/summary_background"
            android:padding="12dp"
            android:text="@string/summary_empty" />

        <!-- Picture of the selected pizza -->
        <ImageView
            android:id="@+id/ivPizza"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/pizza_image_description"
            android:src="@drawable/pizza_margherita" />
    </LinearLayout>
</ScrollView>
